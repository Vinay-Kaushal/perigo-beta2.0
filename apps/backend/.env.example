PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/perigo
REDIS_URL=redis://localhost:6379

# Must be the same random value everywhere it's used; at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-value
JWT_TTL=7d

# Encrypts 2FA secrets and SSO client secrets at rest: 32 random bytes as hex (openssl rand -hex 32).
# Required in production (development derives one from JWT_SECRET). Back it up; changing it makes stored secrets unreadable.
DATA_ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
# Used to build invitation links in emails.
FRONTEND_URL=http://localhost:3000

# Browser sessions use an httpOnly cookie. The web app and API must be same-site
# (e.g. app.example.com + api.example.com); set COOKIE_DOMAIN=.example.com in that case.
COOKIE_DOMAIN=
# Defaults to true in production.
COOKIE_SECURE=

# Ticket attachments are stored here (use a persistent volume in production).
UPLOAD_DIR=./uploads
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENTS_PER_TICKET_MAX=50

# Optional: Google sign-in
GOOGLE_CLIENT_ID=

# Single sign-on (per-organisation OpenID Connect, configured in each org's settings).
# The IdP redirects back to API_PUBLIC_URL/auth/sso/callback.
# true = allow identity providers on private networks (e.g. a self-hosted Keycloak).
SSO_ALLOW_PRIVATE_NETWORK=false
# Development only (refused in production): plain-http issuers such as `bun scripts/mock-oidc.ts`,
# and "skip" to verify claimed domains without a DNS TXT record.
SSO_ALLOW_HTTP_ISSUERS=false
SSO_DOMAIN_VERIFICATION=dns

# Email delivery (invitations, verification, password reset, notifications).
# SMTP takes precedence over Resend; with neither, emails are logged to the console.
SMTP_URL=
RESEND_API_KEY=
MAIL_FROM=perigo <no-reply@yourdomain.com>
# Public URL of this API (used in one-click unsubscribe links).
API_PUBLIC_URL=http://localhost:4000
# Notification emails are batched per user for this many seconds, then sent as one email.
EMAIL_BATCH_WINDOW_SEC=60
# Set to off to run no email worker in this process.
EMAIL_WORKER=on

# Number of reverse proxies in front of the API (for correct client IPs in rate limits and audit logs).
TRUST_PROXY=0
# Rate limits
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_USER_MAX=1200
RATE_LIMIT_BAD_AUTH_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_SIGNUP_MAX=20
RATE_LIMIT_TOKEN_MAX=30
