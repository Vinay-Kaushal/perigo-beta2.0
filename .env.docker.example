# Root .env for docker compose. scripts/docker-up.sh copies this and fills in secrets.
JWT_SECRET=
POSTGRES_PASSWORD=
# Browser origin of the web app; also used for CORS, invite links and websocket origin checks.
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WS_URL=ws://localhost:4001
WEB_PORT=3000
API_PORT=4000
WS_PORT=4001
COOKIE_SECURE=false
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
MAIL_FROM=perigo <no-reply@perigo.local>
RATE_LIMIT_AUTH_MAX=10
